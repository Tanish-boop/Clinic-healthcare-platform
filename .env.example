# ==============================================================================
# MEDINEXUS / APEX CLINIC OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (SQLite for local dev, PostgreSQL for AWS RDS / Production)
# Local SQLite: "file:./dev.db"
# AWS PostgreSQL: "postgresql://postgres:YOUR_PASSWORD@your-rds-endpoint.amazonaws.com:5432/medinexus_db?schema=public"
DATABASE_URL="file:./dev.db"

# Application Environment (development | production)
NODE_ENV="development"

# Canonical URL (e.g., https://yourclinic.com or http://localhost:3001)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Session HMAC Signature Secret (Must be 32+ characters of cryptographically random string)
SESSION_SECRET="change-this-to-a-cryptographically-random-32-character-secret-in-production"

# Timezone
DEFAULT_TIMEZONE="Asia/Kolkata"

# Storage Provider (local | s3)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./uploads"

# AWS S3 Storage (Optional: if storing patient X-rays / scans on AWS S3)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET_NAME=""

# Razorpay Online Payment Gateway (Optional)
RAZORPAY_KEY_ID="rzp_test_mock_12345678"
RAZORPAY_KEY_SECRET="mock_secret_key_87654321"
RAZORPAY_WEBHOOK_SECRET="mock_webhook_secret_9999"

# Automated Notifications
NOTIFICATION_EMAIL_ENABLED="false"
NOTIFICATION_WHATSAPP_ENABLED="false"
